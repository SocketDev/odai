{
  "name": "@socketsecurity/odai",
  "version": "0.2.2-prerelease",
  "private": false,
  "description": "Local on-device AI library for browser and Node, with the bench evaluation harness",
  "homepage": "https://github.com/SocketDev/odai",
  "bugs": {
    "url": "https://github.com/SocketDev/odai/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SocketDev/odai.git"
  },
  "bin": {
    "odai": "./dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.mts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.js"
    },
    "./bench": {
      "source": "./src/bench/index.mts",
      "types": "./dist/bench/index.d.mts",
      "default": "./dist/bench/index.js"
    },
    "./node": {
      "source": "./src/node.mts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/repo/build.mts",
    "check": "node scripts/fleet/check.mts",
    "fix": "node scripts/fleet/fix.mts",
    "format": "node scripts/fleet/format.mts",
    "format:check": "node scripts/fleet/format.mts --check",
    "lint": "node scripts/fleet/lint.mts",
    "prepare": "node scripts/repo/bootstrap/prepare.mts && node scripts/fleet/install-git-hooks.mts && node scripts/fleet/prepare.mts",
    "security": "node scripts/fleet/security.mts",
    "setup:e2e": "node test/scripts/setup-e2e.mts",
    "sync-fleet": "node scripts/repo/bootstrap/fleet.mjs",
    "fleet:status": "node scripts/repo/bootstrap/fleet.mjs --status",
    "test": "node scripts/fleet/test.mts",
    "test:conformance": "node test/scripts/llama-cpp-server-conformance-runner.mts",
    "test:fuzz": "node scripts/repo/fuzz.mts",
    "bench": "node --experimental-strip-types src/bench/run.mts",
    "type": "node node_modules/typescript/bin/tsc --noEmit -p .config/fleet/tsconfig.check.json",
    "update": "node scripts/fleet/update.mts",
    "check:paths": "node scripts/fleet/check/paths-are-canonical.mts",
    "ci:local": "node scripts/fleet/ci/local/run.mts run --all --quiet --pause-on-failure --github-token",
    "clean": "node scripts/fleet/clean.mts",
    "cover": "node scripts/fleet/cover.mts",
    "doctor:auth": "node scripts/fleet/check/setup-is-prompt-less.mts",
    "lockstep": "node scripts/fleet/lockstep.mts",
    "lockstep:emit-mirror-globs": "node scripts/fleet/lockstep-emit-mirror-globs.mts",
    "lockstep:emit-schema": "node scripts/fleet/lockstep-emit-schema.mts",
    "setup-security-tools": "node .claude/hooks/fleet/setup-security-tools/install.mts",
    "sync-oxlint-rules": "node scripts/fleet/sync-oxlint-rules.mts",
    "sync-package-manager-pins": "node scripts/fleet/sync-package-manager-pins.mts",
    "weekly-update": "node scripts/fleet/weekly-update.mts",
    "doctor": "node scripts/fleet/doctor.mts",
    "setup:brew": "node scripts/fleet/setup/brew.mts",
    "setup:go": "node scripts/fleet/setup/go.mts",
    "setup:python": "node scripts/fleet/setup/python.mts",
    "setup:refero": "node scripts/fleet/setup/refero.mts",
    "setup:rust": "node scripts/fleet/setup/rust.mts",
    "npm:publish": "node scripts/fleet/publish-pipeline.mts",
    "prepublishOnly": "echo 'ERROR: Use GitHub Actions workflow for publishing' && exit 1",
    "socket-wheelhouse:emit-schema": "node scripts/fleet/socket-wheelhouse-emit-schema.mts",
    "mcp:reset": "node scripts/fleet/mcp/reset.mts",
    "setup:sfw-ca": "node scripts/fleet/setup/sfw-ca.mts",
    "get-green": "node scripts/fleet/get-green.mts",
    "gen:llms-txt": "node scripts/fleet/gen/llms-txt.mts",
    "weekly-update:ci": "gh workflow run weekly-update.yml",
    "prune:backups": "node scripts/fleet/backup-branches.mts prune",
    "strip:ai-tags": "node scripts/fleet/strip-ai-tags.mts",
    "npm:approve": "node scripts/fleet/publish-pipeline.mts --approve",
    "npm:auth": "node scripts/fleet/npm-auth.mts",
    "npm:dispatch": "node scripts/fleet/registry-infra/remote-npm-publish.mts --publish",
    "npm:staged": "node scripts/fleet/publish-pipeline.mts --status",
    "hide-comments": "node scripts/fleet/hide-comments.mts",
    "ruleset:bypass": "node scripts/fleet/grant-ruleset-bypass.mts",
    "soak:bypass": "node scripts/fleet/soak-bypass.mts",
    "npm:trust": "node scripts/fleet/registry-infra/npm/settings/trust.mts",
    "prune:branch-backups": "node scripts/fleet/backup-branches.mts prune",
    "preflight": "node scripts/fleet/preflight.mts",
    "npm:auth:browser": "node scripts/fleet/npm-auth-browser.mts",
    "npm:auth:cli": "node scripts/fleet/npm-auth-cli.mts",
    "prune:gha-caches": "node scripts/fleet/prune-actions-caches.mts",
    "check:fleet": "node scripts/fleet/check.mts",
    "fix:js": "node scripts/fleet/fix.mts --js",
    "fix:repo": "node scripts/fleet/fix.mts --repo",
    "fmt:js": "node scripts/fleet/format.mts",
    "lint:js": "node scripts/fleet/lint.mts",
    "gh:auth": "node scripts/fleet/gh-auth.mts",
    "offload:model": "node scripts/fleet/offload-model.mts",
    "setup:offload-providers": "node scripts/fleet/setup/offload-providers.mts",
    "sync-global-hooks": "node scripts/fleet/sync-global-hooks.mts",
    "backup": "node scripts/fleet/backup-work.mts",
    "ai:odai:cache": "node scripts/fleet/ai/odai/run.mts cache",
    "ai:odai:diagnose": "node scripts/fleet/ai/odai/run.mts diagnose",
    "update:chrome": "node scripts/fleet/ai/odai/run.mts verify-chrome",
    "audit:consumer-source": "node scripts/fleet/audit/consumer-source.mts",
    "ai-balancer": "node scripts/fleet/ai/balancer/launch.mts",
    "ai-balancer:auth": "node scripts/fleet/ai/balancer/login.mts",
    "ai-balancer:refresh": "node scripts/fleet/ai/balancer/service.mts refresh",
    "ai-balancer:service": "node scripts/fleet/ai/balancer/service.mts",
    "ai:read": "node scripts/fleet/ai/bounded-reader.mts",
    "spend-usage": "node scripts/fleet/spend-usage.mts",
    "build:oxlint-bundle": "node scripts/fleet/build-oxlint-bundle.mts",
    "build:hook-bundle": "node scripts/fleet/build-hook-bundle.mts",
    "build:hook-snapshot": "node scripts/fleet/build-hook-snapshot.mts",
    "build:snapshot-launcher": "node scripts/fleet/build-snapshot-launcher.mts",
    "check:test-budget-headroom": "node scripts/fleet/check/test-budget-headroom.mts",
    "check:workspace-installation": "node scripts/fleet/check/workspace-installation.mts",
    "cover:types": "node scripts/fleet/cover/types/run.mts",
    "depot:auth": "node scripts/fleet/registry-infra/depot/browser-auth.mts",
    "fleet:update": "node scripts/repo/bootstrap/fleet.mjs --if-current",
    "integrity-refresh": "node scripts/fleet/external-tools/refresh.mts",
    "gen:glyph": "node scripts/fleet/gen/glyph.mts",
    "setup:1password": "node scripts/fleet/setup/one-password.mts",
    "setup:ci:local": "node scripts/fleet/ci/local/setup.mts",
    "setup:ci:remote": "node scripts/fleet/ci/remote/setup.mts",
    "setup:ai-clients": "node scripts/fleet/setup/ai-clients.mts",
    "setup:pgbot": "node scripts/fleet/setup/pgbot.mts",
    "mcp:connect": "node scripts/fleet/mcp/connect.mts",
    "mcp:pgbot": "node scripts/fleet/mcp/pgbot/run.mts",
    "mcp:schemas:check": "node scripts/fleet/mcp/schemas.mts check",
    "mcp:schemas:save": "node scripts/fleet/mcp/schemas.mts save",
    "mcp:status": "node scripts/fleet/mcp/connect.mts --status",
    "npm:inventory": "node scripts/fleet/registry-infra/npm/account-inventory-read.mts",
    "soak:check": "node scripts/fleet/check/soak-time-is-consistent.mts",
    "sweep:worktrees": "node scripts/fleet/worktree-sweep.mts",
    "sweep:worktrees:visit": "node scripts/fleet/worktree/sweep/run.mts",
    "test:profile": "node scripts/fleet/test/profile.mts",
    "update:pnpm": "node scripts/fleet/update/pnpm.mts",
    "check:package": "node scripts/repo/check/package.mts",
    "lockstep:assist": "node scripts/fleet/lockstep/assist/run.mts",
    "release:hint": "node scripts/fleet/release/hint.mts"
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:",
    "@types/dom-chromium-ai": "0.0.17"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "catalog:",
    "@mdn/browser-compat-data": "catalog:",
    "@playwright/mcp": "catalog:",
    "@shadscan/cli": "catalog:",
    "@socketregistry/packageurl-js": "catalog:",
    "@socketregistry/packageurl-js-stable": "catalog:",
    "@socketsecurity/lib": "catalog:",
    "@socketsecurity/lib-stable": "catalog:",
    "@socketsecurity/sdk": "catalog:",
    "@socketsecurity/sdk-stable": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@types/shell-quote": "catalog:",
    "@ultrathink/acorn.rs.wasm": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@vitiate/core": "catalog:",
    "ast-v8-to-istanbul": "catalog:",
    "c8": "catalog:",
    "chrome-devtools-mcp": "catalog:",
    "fast-check": "catalog:",
    "magic-string": "catalog:",
    "markdownlint-cli2": "catalog:",
    "mcp-tada": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm": "catalog:",
    "mdast-util-to-markdown": "catalog:",
    "micromark": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "neosanitize": "catalog:",
    "nock": "catalog:",
    "npm-high-impact": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "parse5": "catalog:",
    "playwright-core": "catalog:",
    "portless": "catalog:",
    "regjsparser": "catalog:",
    "rolldown": "catalog:",
    "run-local-ci": "catalog:",
    "semver": "catalog:",
    "shell-quote": "catalog:",
    "svgo": "catalog:",
    "taze": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitiate": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "playwright-core": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "npm",
        "version": "^11.19.0 || >=12.0.2",
        "onFail": "error"
      },
      {
        "name": "pnpm",
        "version": "^11.25.0 || >=12.3.4",
        "onFail": "error"
      }
    ]
  },
  "engines": {
    "node": ">=24",
    "npm": "^11.19.0 || >=12.0.2",
    "pnpm": "^11.25.0 || >=12.3.4"
  },
  "allowScripts": {
    "cpu-features": false,
    "protobufjs": false,
    "puppeteer": false,
    "ssh2": false
  }
}
